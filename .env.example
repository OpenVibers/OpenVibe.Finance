# OpenVibe.Finance (/etc/openvibe/finance.env on the host). Values are never committed.
BASE_URL=https://openvibe.finance
PORT=5292
DATABASE_URL=
DATABASE_DIRECT_URL=
# 32 random bytes, base64: the service key every person's key is derived from (server/crypto.js). Losing it loses the
# payees and notes; rotating it needs a re-seal.
FINANCE_DATA_KEY=
OV_OAUTH_CLIENT_ID=finance
OV_OAUTH_CLIENT_SECRET=
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
